PORT=5000

PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=3306
PRIMARY_DB_USER=root
PRIMARY_DB_PASSWORD=your_mysql_password
PRIMARY_DB_NAME=farmer_db
PRIMARY_DB_STATUS=RUNNING

# SECONDARY 1
SECONDARY1_DB_HOST=localhost
SECONDARY1_DB_PORT=3306
SECONDARY1_DB_USER=root
SECONDARY1_DB_PASSWORD=your_mysql_password
SECONDARY1_DB_NAME=farmer_db
SECONDARY1_DB_STATUS=RUNNING

# SECONDARY 2
SECONDARY2_DB_HOST=localhost
SECONDARY2_DB_PORT=3306
SECONDARY2_DB_USER=root
SECONDARY2_DB_PASSWORD=your_mysql_password
SECONDARY2_DB_NAME=farmer_db
SECONDARY2_DB_STATUS=RUNNING

# SECONDARY 3
SECONDARY3_DB_HOST=localhost
SECONDARY3_DB_PORT=3306
SECONDARY3_DB_USER=root
SECONDARY3_DB_PASSWORD=your_mysql_password
SECONDARY3_DB_NAME=farmer_db
SECONDARY3_DB_STATUS=RUNNING

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
AADHAAR_PEPPER=your_aadhaar_pepper

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/farmer_history

NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Two-Factor Verification for Government Portal
GOV_SECURITY_VERIFICATION_PASSWORD=your_gov_2fa_password

# Login and OTP Abuse Protection (In-Memory Map Rate Limiting)
# X: Maximum permitted failed login/OTP attempts before temporary lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
# Y: Lockout duration in hours once maximum failed attempts threshold is reached
LOGIN_LOCKOUT_HOURS=2
# OTP resend cooldown duration in minutes between successive OTP generation requests
OTP_RESEND_COOLDOWN_MINUTES=5

# Payment Portal Backend Environment Configuration Template
PORT=5004
NODE_ENV=development
FRONTEND_URL=http://localhost:3004

# JWT Authentication (Cookie name: payment_token)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Aadhaar Blind Index Security Pepper
AADHAAR_PEPPER=your_aadhaar_pepper_secret_here

# MongoDB Connection for Audit Logs
MONGO_URI=mongodb://127.0.0.1:27017/farmer_history

# Primary MySQL Database (Write DB & Critical Status Transitions)
PRIMARY_DB_HOST=localhost
PRIMARY_DB_PORT=3306
PRIMARY_DB_USER=your_db_user
PRIMARY_DB_PASSWORD=your_db_password
PRIMARY_DB_NAME=farmer_db
PRIMARY_DB_STATUS=RUNNING

# Secondary MySQL Database 1 (Read Replicas)
SECONDARY1_DB_HOST=localhost
SECONDARY1_DB_PORT=3306
SECONDARY1_DB_USER=your_db_user
SECONDARY1_DB_PASSWORD=your_db_password
SECONDARY1_DB_NAME=farmer_db
SECONDARY1_DB_STATUS=RUNNING

# Secondary MySQL Database 2 (Read Replicas)
SECONDARY2_DB_HOST=localhost
SECONDARY2_DB_PORT=3306
SECONDARY2_DB_USER=your_db_user
SECONDARY2_DB_PASSWORD=your_db_password
SECONDARY2_DB_NAME=farmer_db
SECONDARY2_DB_STATUS=RUNNING

# Secondary MySQL Database 3 (Read Replicas)
SECONDARY3_DB_HOST=localhost
SECONDARY3_DB_PORT=3306
SECONDARY3_DB_USER=your_db_user
SECONDARY3_DB_PASSWORD=your_db_password
SECONDARY3_DB_NAME=farmer_db
SECONDARY3_DB_STATUS=RUNNING

# Audit Log Retention Configuration
# Years to retain logs before MongoDB TTL index automatically cleans them up
PAYMENT_LOG_RETENTION_YEARS=5
# Days of recent activity to display on Dashboard
PAYMENT_RECENT_LOG_DAYS=7

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# Login and OTP Abuse Protection (In-Memory Map Rate Limiting)
# X: Maximum permitted failed login/OTP attempts before temporary lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
# Y: Lockout duration in hours once maximum failed attempts threshold is reached
LOGIN_LOCKOUT_HOURS=2
# OTP resend cooldown duration in minutes between successive OTP generation requests
OTP_RESEND_COOLDOWN_MINUTES=5
